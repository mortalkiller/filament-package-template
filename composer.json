{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "mortalkiller/filament-package-template",
  "description": "Template for MortalKiller Filament packages.",
  "homepage": "https://github.com/mortalkiller/filament-package-template",
  "keywords": [
    "filament",
    "laravel"
  ],
  "type": "library",
  "license": "MIT",
  "support": {
    "issues": "https://github.com/mortalkiller/filament-package-template/issues",
    "source": "https://github.com/mortalkiller/filament-package-template"
  },
  "require": {
    "php": "^8.2",
    "filament/filament": "^5.8.1",
    "illuminate/support": "^12.0|^13.0",
    "spatie/laravel-package-tools": "^1.15.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "mortalkiller/filament-package-standard": "^2.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0",
    "rector/rector": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "MortalKiller\\FilamentPackageTemplate\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MortalKiller\\FilamentPackageTemplate\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MortalKiller\\FilamentPackageTemplate\\FilamentPackageTemplateServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "pint --test",
    "format": "pint",
    "refactor": "rector",
    "test": "phpunit",
    "test:refactor": "rector --dry-run",
    "check": [
      "@lint",
      "@analyse",
      "@test:refactor",
      "@test"
    ]
  }
}
